# Copy values into the host's environment. The process does not read .env by itself.

PORT=4317

# Leave blank to leave the desk unlocked.
AUTH_PASSWORD=
AUTH_SECRET=

# Optional. When unset, state is DATA_DIR/state.json.
FIREBASE_SERVICE_ACCOUNT=

# A card needs this many different sources before it shows on Pulse.
MULTI_WINDOW_HOURS=6
MULTI_MIN_SOURCES=2

SNAPSHOT_INTERVAL_MS=300000
DATA_DIR=data

# Optional. GitHub code search needs it. README search works without it.
GITHUB_TOKEN=

# YouTube channels checked for Solana in the captions. Blank uses the Solana channel.
YOUTUBE_CHANNEL_IDS=

# Hacker News front page. Stories under this many points are dropped.
HN_MIN_POINTS=40
