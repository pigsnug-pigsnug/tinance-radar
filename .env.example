# Copy to .env for local overrides. The process reads the environment directly;
# you do not need a dotenv package. With none of these set, the app runs with
# auth disabled and JSON files under DATA_DIR.

PORT=4317

# Leave blank to disable auth (a warning is printed). Set both in production.
AUTH_PASSWORD=
# Optional signing key. Defaults to AUTH_PASSWORD.
AUTH_SECRET=

# Firebase service account JSON, either raw one-line JSON or base64.
# When unset, state is stored in DATA_DIR/state.json.
FIREBASE_SERVICE_ACCOUNT=

# Topic is multi-signal when this many distinct sources mention it inside the window.
MULTI_WINDOW_HOURS=6
MULTI_MIN_SOURCES=3

# Radar snapshot write interval. 5 minutes stays far under Firestore free quotas.
SNAPSHOT_INTERVAL_MS=300000

DATA_DIR=data

# Public Telegram channels, comma-separated, without @ or t.me.
TELEGRAM_CHANNELS=cointelegraph,WatcherGuru

# YouTube channel IDs. When unset, the official Solana channel is used.
YOUTUBE_CHANNEL_IDS=

# Bluesky jetstream: emit a feed row when a tracked phrase is mentioned at least
# this many times in a minute.
BLUESKY_MIN_COUNT=5
